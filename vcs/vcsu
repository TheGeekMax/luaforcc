-- vcsu.lua
-- Complement de vcs : telecharge un projet entier d'un coup a partir
-- d'un fichier manifeste stocke dans download/ a la racine du repo.
--
-- Format d'un manifeste (download/projet1, sans extension) :
--
--   -- ceci est un commentaire (ligne entiere uniquement)
--
--   #include: libs            -- inclut les fichiers du projet "libs"
--   #startup: main.lua        -- lance ce fichier au boot
--
--   foldera/file1::main.lua
--   folderb/file3::lib/file3.lua
--
-- Regles :
--   - une ligne commencant par "--" est un commentaire
--   - PAS de commentaire en fin de ligne fonctionnelle
--   - "remote::local" : local est relatif au DOSSIER COURANT
--   - #startup: prend un chemin LOCAL (apres download)
--   - en cas de #startup: multiples (via includes), celui du manifeste
--     appele en ligne de commande gagne
--
-- Usage :
--   vcsu get <projet> [--no-startup]
--   vcsu list <projet>

local CONFIG_FILE = "/.vcsconfig"
local STARTUP_FILE = "/startup.lua"

local STARTUP_BEGIN = "-- >>> vcsu startup >>>"
local STARTUP_END = "-- <<< vcsu startup <<<"

-- ==========================================================
-- Chemins
-- ==========================================================

-- fs.* travaille toujours depuis la racine et ignore le dossier courant
-- du shell : il faut donc resoudre les chemins relatifs soi-meme.
local function resolvePath(path)
    if path:sub(1, 1) == "/" then
        return path
    end
    return shell.resolve(path)
end

-- ==========================================================
-- Config (meme fichier que vcs)
-- ==========================================================

local function loadConfig()
    if not fs.exists(CONFIG_FILE) then
        return nil
    end
    local f = fs.open(CONFIG_FILE, "r")
    local content = f.readAll()
    f.close()
    local ok, data = pcall(textutils.unserialize, content)
    if not ok or type(data) ~= "table" then
        return nil
    end
    data.files = data.files or {}
    return data
end

local function saveConfig(cfg)
    local f = fs.open(CONFIG_FILE, "w")
    f.write(textutils.serialize(cfg))
    f.close()
end

local function requireConfig()
    local cfg = loadConfig()
    if not cfg or not cfg.repo then
        print("Aucune config trouvee.")
        print("Lance d'abord : vcs config <owner/repo> [branch]")
        return nil
    end
    return cfg
end

-- meme format de tracking que vcs : { remote = "...", dest = "..." }
-- dest toujours absolu
local function trackFile(cfg, remote, dest)
    for _, entry in ipairs(cfg.files) do
        if entry.remote == remote and entry.dest == dest then
            return
        end
    end
    table.insert(cfg.files, { remote = remote, dest = dest })
end

-- ==========================================================
-- Reseau
-- ==========================================================

local function buildRawURL(cfg, path)
    return "https://raw.githubusercontent.com/" .. cfg.repo .. "/" .. cfg.branch .. "/" .. path
end

local function fetchAndSave(cfg, remotePath, destPath)
    local url = buildRawURL(cfg, remotePath)

    local response, err = http.get(url)
    if not response then
        return false, "Echec du telechargement : " .. tostring(err)
    end

    local content = response.readAll()
    response.close()

    if not content or content == "" then
        return false, "Reponse vide, abandon."
    end

    local dir = fs.getDir(destPath)
    if dir ~= "" and not fs.exists(dir) then
        fs.makeDir(dir)
    end

    if fs.exists(destPath) then
        fs.delete(destPath)
    end

    local f = fs.open(destPath, "w")
    f.write(content)
    f.close()

    return true, destPath .. " (" .. #content .. " octets)"
end

-- Recupere le contenu brut du manifeste download/<name> depuis le repo.
local function fetchManifest(cfg, name)
    local url = buildRawURL(cfg, "download/" .. name)
    local response, err = http.get(url)
    if not response then
        return nil, "Manifeste '" .. name .. "' introuvable (" .. tostring(err) .. ")"
    end
    local content = response.readAll()
    response.close()
    if not content or content == "" then
        return nil, "Manifeste '" .. name .. "' vide."
    end
    return content
end

-- Liste les fichiers d'un dossier du depot via l'API GitHub.
-- raw.githubusercontent.com ne sait pas lister un dossier, d'ou le
-- passage par api.github.com (limite a 60 requetes/heure sans jeton).
-- Retourne une liste de chemins, non recursive.
local function listFolder(cfg, folder)
    local url = ("https://api.github.com/repos/%s/contents/%s?ref=%s")
        :format(cfg.repo, folder, cfg.branch)

    local response, err = http.get(url)
    if not response then
        return nil, ("Impossible de lister '%s' (%s)"):format(folder, tostring(err))
    end

    local body = response.readAll()
    response.close()

    local ok, data = pcall(textutils.unserialiseJSON, body)
    if not ok or type(data) ~= "table" then
        return nil, ("Reponse illisible pour '%s'."):format(folder)
    end

    -- l'API renvoie un objet (et non un tableau) en cas d'erreur
    if data.message then
        return nil, ("'%s' : %s"):format(folder, data.message)
    end

    local files = {}
    for _, item in ipairs(data) do
        if item.type == "file" then
            files[#files + 1] = item.path
        end
    end

    if #files == 0 then
        return nil, ("Aucun fichier dans '%s'."):format(folder)
    end

    return files
end

-- ==========================================================
-- Parsing (pur, aucune I/O)
-- ==========================================================

-- Retourne une liste ordonnee d'items types :
--   { kind = "file",    remote = "...", dest = "..." }
--   { kind = "include", project = "..." }
--   { kind = "all",     folder = "..." }
--   { kind = "startup", target = "..." }
local function parseManifest(text, name)
    local items = {}
    local lineNo = 0

    for line in text:gmatch("[^\r\n]+") do
        lineNo = lineNo + 1
        local trimmed = line:match("^%s*(.-)%s*$")

        -- ligne vide ou commentaire
        if trimmed == "" or trimmed:sub(1, 2) == "--" then
            -- ignore

        -- macro
        elseif trimmed:sub(1, 1) == "#" then
            local macro, value = trimmed:match("^#%s*([%w_]+)%s*:%s*(.-)$")
            if not macro or value == "" then
                print(("[%s:%d] macro invalide : %s"):format(name, lineNo, trimmed))
            elseif macro == "include" then
                table.insert(items, { kind = "include", project = value })
            elseif macro == "all" then
                table.insert(items, { kind = "all", folder = value })
            elseif macro == "startup" then
                table.insert(items, { kind = "startup", target = value })
            else
                print(("[%s:%d] macro inconnue : #%s"):format(name, lineNo, macro))
            end

        -- ligne fichier
        else
            local remote, dest = trimmed:match("^(.-)%s*::%s*(.-)$")
            if remote and dest and remote ~= "" and dest ~= "" then
                table.insert(items, { kind = "file", remote = remote, dest = dest })
            else
                print(("[%s:%d] ligne ignoree (format invalide) : %s"):format(name, lineNo, trimmed))
            end
        end
    end

    return items
end

-- ==========================================================
-- Resolution (recursive, avec includes)
-- ==========================================================

-- Accumule les fichiers de <name> et de ses includes.
-- acc = { files = {}, seen = {}, startups = {}, order = {} }
-- Retourne false + message si un manifeste est introuvable.
local function resolveProject(cfg, name, acc, depth)
    depth = depth or 0

    if acc.visited[name] then
        print(("(include ignore, deja traite : %s)"):format(name))
        return true
    end
    acc.visited[name] = true

    local text, err = fetchManifest(cfg, name)
    if not text then
        return false, err
    end

    table.insert(acc.order, { name = name, depth = depth })

    local items = parseManifest(text, name)

    for _, item in ipairs(items) do
        if item.kind == "include" then
            local ok, ierr = resolveProject(cfg, item.project, acc, depth + 1)
            if not ok then
                return false, ierr
            end

        elseif item.kind == "startup" then
            table.insert(acc.startups, { project = name, target = item.target, depth = depth })

        elseif item.kind == "file" then
            local dest = resolvePath(item.dest)
            local key = item.remote .. "\0" .. dest
            if not acc.seen[key] then
                acc.seen[key] = true
                table.insert(acc.files, {
                    remote = item.remote,
                    dest = dest,
                    project = name,
                })
            end
        end
    end

    return true
end

local function newAcc()
    return { files = {}, seen = {}, visited = {}, startups = {}, order = {} }
end

-- ==========================================================
-- Bloc startup
-- ==========================================================

-- Retire le bloc vcsu existant du contenu de startup.lua.
-- Recherche en plain-text (pas de regex) pour eviter les soucis
-- d'echappement avec les tirets des marqueurs.
local function stripStartupBlock(content)
    local s = content:find(STARTUP_BEGIN, 1, true)
    if not s then
        return content, false
    end

    local e = content:find(STARTUP_END, s, true)
    if not e then
        -- marqueur de fin manquant : on coupe a partir du debut
        return content:sub(1, s - 1), true
    end

    local after = e + #STARTUP_END
    -- avale le retour a la ligne qui suit le marqueur de fin
    if content:sub(after, after) == "\n" then
        after = after + 1
    end

    return content:sub(1, s - 1) .. content:sub(after), true
end

local function writeStartupBlock(targetPath)
    local existing = ""
    if fs.exists(STARTUP_FILE) then
        local f = fs.open(STARTUP_FILE, "r")
        existing = f.readAll()
        f.close()
    end

    local cleaned, hadBlock = stripStartupBlock(existing)

    -- normalise la fin de fichier avant d'appondre
    cleaned = cleaned:gsub("%s+$", "")
    if cleaned ~= "" then
        cleaned = cleaned .. "\n"
    end

    local block = STARTUP_BEGIN .. "\n"
        .. ('shell.run("%s")\n'):format(targetPath)
        .. STARTUP_END .. "\n"

    local f = fs.open(STARTUP_FILE, "w")
    f.write(cleaned .. block)
    f.close()

    if hadBlock then
        print("Bloc startup remplace -> " .. targetPath)
    else
        print("Bloc startup ajoute -> " .. targetPath)
    end
end

-- Choisit le startup a appliquer : celui du manifeste demande en CLI
-- (depth 0) gagne sur ceux venant des includes.
local function pickStartup(startups)
    if #startups == 0 then
        return nil
    end

    local chosen = startups[1]
    for _, s in ipairs(startups) do
        if s.depth < chosen.depth then
            chosen = s
        end
    end

    if #startups > 1 then
        print("Attention : plusieurs #startup: declares")
        for _, s in ipairs(startups) do
            local mark = (s == chosen) and " <- retenu" or ""
            print("  " .. s.project .. " : " .. s.target .. mark)
        end
    end

    return chosen
end

-- ==========================================================
-- Commands
-- ==========================================================

local function cmdGet(args)
    local name = nil
    local noStartup = false

    for _, a in ipairs(args) do
        if a == "--no-startup" then
            noStartup = true
        elseif not name then
            name = a
        end
    end

    if not name then
        print("Usage: vcsu get <projet> [--no-startup]")
        return
    end

    local cfg = requireConfig()
    if not cfg then return end

    -- 1. resolution complete AVANT tout telechargement :
    --    un include casse = rien d'ecrit sur le disque
    print("Resolution de : " .. name)
    local acc = newAcc()
    local ok, err = resolveProject(cfg, name, acc)
    if not ok then
        print(err)
        print("Rien n'a ete telecharge.")
        return
    end

    if #acc.files == 0 then
        print("Aucun fichier a telecharger.")
        return
    end

    print(("%d fichier(s) a recuperer."):format(#acc.files))

    -- 2. telechargement
    local okCount, failCount = 0, 0

    for _, entry in ipairs(acc.files) do
        print("GET " .. entry.remote)
        local fok, msg = fetchAndSave(cfg, entry.remote, entry.dest)
        if fok then
            print("  OK -> " .. msg)
            trackFile(cfg, entry.remote, entry.dest)
            okCount = okCount + 1
        else
            print("  " .. msg)
            failCount = failCount + 1
        end
    end

    saveConfig(cfg)

    -- 3. startup
    local startup = pickStartup(acc.startups)
    if startup then
        if noStartup then
            print("(--no-startup : bloc startup non applique)")
        elseif failCount > 0 then
            print("Echecs detectes : bloc startup non applique.")
        else
            writeStartupBlock(resolvePath(startup.target))
        end
    end

    print(("Termine : %d ok, %d echec(s)"):format(okCount, failCount))
end

local function cmdList(args)
    local name = args[1]
    if not name then
        print("Usage: vcsu list <projet>")
        return
    end

    local cfg = requireConfig()
    if not cfg then return end

    local acc = newAcc()
    local ok, err = resolveProject(cfg, name, acc)
    if not ok then
        print(err)
        return
    end

    print("Manifestes resolus :")
    for _, m in ipairs(acc.order) do
        print("  " .. string.rep("  ", m.depth) .. m.name)
    end

    print("Fichiers :")
    for _, entry in ipairs(acc.files) do
        print("  " .. entry.remote .. " -> " .. entry.dest)
    end

    local startup = pickStartup(acc.startups)
    if startup then
        print("Startup : " .. resolvePath(startup.target))
    else
        print("Startup : aucun")
    end

    print(("Total : %d fichier(s)"):format(#acc.files))
end

local function printHelp()
    print("vcsu get <projet> [--no-startup]")
    print("vcsu list <projet>")
end

-- ==========================================================
-- Entry point
-- ==========================================================

local args = { ... }
local sub = args[1]

if sub == "get" then
    cmdGet({ table.unpack(args, 2) })
elseif sub == "list" then
    cmdList({ table.unpack(args, 2) })
else
    printHelp()
end